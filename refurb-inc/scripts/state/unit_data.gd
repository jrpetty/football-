class_name UnitData
extends RefCounted
## Everything that is true about one piece of hardware. Internal faults are hidden until tested.

const STAGE_UNTESTED := "untested"
const STAGE_FAULTY := "faulty"
const STAGE_TO_IMAGE := "to_image"
const STAGE_TO_GRADE := "to_grade"
const STAGE_GRADED := "graded"
const STAGE_LISTED := "listed"
const STAGE_SOLD := "sold"
const STAGE_SHIPPED := "shipped"

var model_id: String = ""
var serial: String = ""
var cpu_id: String = ""
var ram_gb: int = 8
var storage_gb: int = 256
var battery_pct: int = 90
var cosmetic: Array = []          # condition ids still present
var faults: Array = []            # [{ "id": String, "detail": Dictionary, "fixed": bool }]
var tested: bool = false
var test_report: Dictionary = {}  # generated by the test station
var imaged: bool = false
var grade: String = ""            # "", A, B, C, D, S (S = spares/repairs, shown as "D – Spares/Repairs")
var list_price: int = 0
var listed: bool = false
var order_id: int = 0
var lot_id: int = 0
var cost: int = 0                 # what we paid per unit (for profit stats)
var seller_name: String = ""
var shipped: bool = false
var history: Array = []           # short audit trail [[game_min, text], …] — feeds the Stock app
# Timeline + costs for the Insights app (game minutes; -1 = not yet).
var received: float = -1.0
var graded_at: float = -1.0
var listed_at: float = -1.0
var sold_at: float = -1.0
var parts_cost: int = 0           # value of parts fitted during repair


func display_name() -> String:
	return Content.model_display_name(model_id)


func model() -> Dictionary:
	return Content.model(model_id)


func cpu_name() -> String:
	return Content.cpu(cpu_id).get("name", cpu_id)


func spec_line() -> String:
	var storage := ("%dGB" % storage_gb) if storage_gb < 1000 else ("%dTB" % int(storage_gb / 1000.0))
	var st_type := "NVMe" if model().get("storage_type", "") == "nvme_m2" else "SSD"
	return "%s · %dGB RAM · %s %s" % [cpu_name(), ram_gb, storage, st_type]


func open_faults() -> Array:
	return faults.filter(func(f): return not f.get("fixed", false))


func has_open_faults() -> bool:
	return not open_faults().is_empty()


func cosmetic_score() -> int:
	var score := 100
	for c in cosmetic:
		score -= int(Content.condition(c).get("penalty", 0))
	return maxi(score, 0)


func cosmetic_text() -> String:
	## Hover tag: EXTERNAL condition only (internal faults stay hidden until tested).
	if cosmetic.is_empty():
		return "Pristine — no visible wear"
	var parts: PackedStringArray = []
	for c in cosmetic:
		parts.append(Content.condition(c).get("text", c))
	return ", ".join(parts)


func stage() -> String:
	if shipped:
		return STAGE_SHIPPED
	if order_id != 0:
		return STAGE_SOLD
	if listed:
		return STAGE_LISTED
	if grade != "":
		return STAGE_GRADED
	if not tested:
		return STAGE_UNTESTED
	if has_open_faults():
		return STAGE_FAULTY
	if not imaged:
		return STAGE_TO_IMAGE
	return STAGE_TO_GRADE


func stage_text() -> String:
	match stage():
		STAGE_UNTESTED: return "Untested"
		STAGE_FAULTY: return "Faulty — needs repair"
		STAGE_TO_IMAGE: return "Passed — needs wipe & image"
		STAGE_TO_GRADE: return "Imaged — ready to grade"
		STAGE_GRADED: return "Grade %s — in stock" % grade_label(grade)
		STAGE_LISTED: return "Grade %s — listed £%d" % [grade_label(grade), list_price]
		STAGE_SOLD: return "SOLD — pack for order #%d" % order_id
		STAGE_SHIPPED: return "Shipped"
	return ""


static func grade_label(g: String) -> String:
	return "D (Spares/Repairs)" if g == "S" else g


func log_event(game_min: float, text: String) -> void:
	history.append([int(game_min), text])
	if history.size() > 24:
		history.pop_front()


func to_dict() -> Dictionary:
	return {
		"model_id": model_id, "serial": serial, "cpu_id": cpu_id, "ram_gb": ram_gb, "storage_gb": storage_gb,
		"battery_pct": battery_pct, "cosmetic": cosmetic.duplicate(), "faults": faults.duplicate(true),
		"tested": tested, "test_report": test_report.duplicate(true), "imaged": imaged, "grade": grade,
		"list_price": list_price, "listed": listed, "order_id": order_id, "lot_id": lot_id, "cost": cost,
		"seller_name": seller_name, "shipped": shipped, "history": history.duplicate(true),
		"received": received, "graded_at": graded_at, "listed_at": listed_at, "sold_at": sold_at, "parts_cost": parts_cost,
	}


static func from_dict(d: Dictionary) -> UnitData:
	var u := UnitData.new()
	u.model_id = d.get("model_id", "")
	u.serial = d.get("serial", "")
	u.cpu_id = d.get("cpu_id", "")
	u.ram_gb = int(d.get("ram_gb", 8))
	u.storage_gb = int(d.get("storage_gb", 256))
	u.battery_pct = int(d.get("battery_pct", 90))
	u.cosmetic = d.get("cosmetic", []).duplicate()
	u.faults = d.get("faults", []).duplicate(true)
	u.tested = bool(d.get("tested", false))
	u.test_report = d.get("test_report", {}).duplicate(true)
	u.imaged = bool(d.get("imaged", false))
	u.grade = d.get("grade", "")
	u.list_price = int(d.get("list_price", 0))
	u.listed = bool(d.get("listed", false))
	u.order_id = int(d.get("order_id", 0))
	u.lot_id = int(d.get("lot_id", 0))
	u.cost = int(d.get("cost", 0))
	u.seller_name = d.get("seller_name", "")
	u.shipped = bool(d.get("shipped", false))
	u.history = d.get("history", []).duplicate(true)
	u.received = float(d.get("received", -1.0))
	u.graded_at = float(d.get("graded_at", -1.0))
	u.listed_at = float(d.get("listed_at", -1.0))
	u.sold_at = float(d.get("sold_at", -1.0))
	u.parts_cost = int(d.get("parts_cost", 0))
	return u
