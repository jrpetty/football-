{
  "name": "sightline-coach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sightline — a screen-only, local-first AI gameplay coach. Pixels in, calm spoken feedback out.",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "node --test test/*.test.ts",
    "profile:check": "node scripts/check-profile.ts",
    "data:aoe4": "node scripts/check-aoe4-data.mjs",
    "e2e": "node e2e/app.e2e.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@laihoe/demoparser2": "0.42.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "seek-bzip": "^2.0.0",
    "sherpa-onnx": "^1.13.8",
    "sherpa-onnx-node": "1.13.8",
    "three": "0.186.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "vite": "^5.4.6"
  },
  "productName": "Sightline Coach",
  "author": "Sightline",
  "build": {
    "appId": "app.sightline.coach",
    "productName": "Sightline Coach",
    "copyright": "Sightline",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "!**/*.map"
    ],
    "asar": false,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Sightline-Coach-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sightline Coach",
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.png"
    }
  }
}
