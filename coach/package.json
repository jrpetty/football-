{
  "name": "sightline-coach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sightline — a screen-only, local-first AI gameplay coach. Pixels in, calm spoken feedback out.",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "node --test test/*.test.ts",
    "profile:check": "node scripts/check-profile.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "seek-bzip": "^2.0.0",
    "sherpa-onnx": "^1.13.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "44.5.1",
    "typescript": "5.9.3",
    "vite": "^5.4.6"
  }
}
