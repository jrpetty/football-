; Engine configuration file.
config_version=5

[application]

config/name="REKINDLE"
config/description="Open-world zombie survival and town building."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[autoload]

Settings="*res://scripts/settings.gd"
WorldData="*res://scripts/world_data.gd"
Sfx="*res://scripts/sfx.gd"

[physics]

3d/default_gravity=22.0
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=3
