{
  "compilerOptions": {
    "target": "ES2022",
    // The tests import pure functions from modules that also carry
    // browser-only helpers, so the DOM types have to be visible here too.
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "test", "e2e", "scripts"]
}
