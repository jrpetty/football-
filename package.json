{
  "name": "open-pitch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Open Pitch — a physics-driven, input-driven browser football game",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.game.json --noEmit && vite build",
    "build:single": "tsc -p tsconfig.game.json --noEmit && vite build --config vite.single.config.ts && node scripts/build-single.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.game.json --noEmit",
    "test": "node tests/run.mjs",
    "test:anim": "node tests/browser/anim.mjs",
    "test:spin": "node tests/browser/spin.mjs",
    "relay": "node scripts/relay.mjs",
    "test:net": "node tests/browser/net.mjs",
    "test:replay": "node tests/browser/replay2d.mjs",
    "test:settings": "node tests/browser/settings.mjs",
    "test:perf": "node tests/browser/perf.mjs",
    "test:quality": "node tests/browser/quality.mjs"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "ws": "^8.18.0"
  },
  "dependencies": {
    "@types/three": "^0.160.0",
    "three": "^0.160.1"
  }
}
