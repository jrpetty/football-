# Copy to config/secrets.yml (gitignored) and fill in. Environment variables
# override this file: PRICER_EBAY__CLIENT_ID, PRICER_AMAZON__REFRESH_TOKEN, etc.

ebay:
  client_id: ""            # developer.ebay.com > My Account > Application Keys
  client_secret: ""
  redirect_uri: ""         # your RuName, needed for seller consent
  refresh_token: ""        # written by `pricer authorize ebay` — do not type by hand
  # Set true ONLY if your application has been granted buy.marketplace.insights.
  # eBay's docs state that API is closed to new applicants.
  insights_approved: false

amazon:
  refresh_token: ""        # Seller Central > Apps & Services > Develop Apps
  client_id: ""
  client_secret: ""

backmarket:
  token: ""                # merchant API token from your Back Market account
  scheme: "Basic"          # or "Token", depending on your account
