-----------------------------------------------------------------------------
-- td_adapter.scar
--
-- ENGINE ADAPTER LAYER.
--
-- Every call into the AoE4 Scar API that this mod depends on lives here and
-- nowhere else. The game logic in td_zones / td_score / territorydomination
-- talks only to the TD_API.* functions below.
--
-- WHY: if an engine function has been renamed, or its signature differs from
-- what this mod expects, the fix is a one-line change in this file rather
-- than a hunt through the gameplay code. Each function is small enough to
-- verify against the real API in isolation.
--
-- Every function here is wrapped in a guarded call, so a missing engine
-- function degrades to a logged warning and a safe default instead of
-- killing the whole script. Check the in-game log for "TD_API MISSING" to
-- find the ones that need correcting.
-----------------------------------------------------------------------------

TD_API = {}

-- Set true to print every adapter miss to the log.
TD_API.verbose = true

local function _warn(name)
	if TD_API.verbose then
		print("[TerritoryDomination] TD_API MISSING or FAILED: " .. tostring(name))
	end
end

-- Call an engine function by name if it exists; return (ok, result).
-- Never raises: a missing or throwing engine function returns ok == false.
local function _try(fnName, ...)
	local fn = _G[fnName]
	if type(fn) ~= "function" then
		_warn(fnName .. " (not defined)")
		return false, nil
	end
	local ok, result = pcall(fn, ...)
	if not ok then
		_warn(fnName .. " (error: " .. tostring(result) .. ")")
		return false, nil
	end
	return true, result
end

-- Try a list of candidate function names in order, first one that exists wins.
-- Used where the exact engine name is uncertain between versions.
local function _tryAny(fnNames, ...)
	for _, name in ipairs(fnNames) do
		if type(_G[name]) == "function" then
			local ok, result = pcall(_G[name], ...)
			if ok then
				return true, result
			end
			_warn(name .. " (error: " .. tostring(result) .. ")")
		end
	end
	_warn(table.concat(fnNames, " / ") .. " (none defined)")
	return false, nil
end

-----------------------------------------------------------------------------
-- PLAYERS
-----------------------------------------------------------------------------

-- Returns an array of player IDs for every human/AI player in the match.
function TD_API.GetPlayers()
	local players = {}
	local ok, count = _try("World_GetPlayerCount")
	if not ok or count == nil then
		return players
	end
	for i = 0, count - 1 do
		local gotPlayer, player = _try("World_GetPlayerAt", i)
		if gotPlayer and player ~= nil then
			table.insert(players, player)
		end
	end
	return players
end

function TD_API.IsPlayerAlive(player)
	local ok, alive = _tryAny({ "Player_IsAlive", "Player_IsActive" }, player)
	if not ok then
		return true -- assume alive rather than silently eliminating someone
	end
	return alive == true or alive == 1
end

function TD_API.GetPlayerName(player)
	local ok, name = _tryAny({ "Player_GetDisplayName", "Player_GetName" }, player)
	if ok and name ~= nil then
		return tostring(name)
	end
	return "Player " .. tostring(player)
end

-----------------------------------------------------------------------------
-- MAP GEOMETRY
-----------------------------------------------------------------------------

-- Playable map dimensions, in world units.
function TD_API.GetMapDimensions()
	local okW, width = _tryAny({ "World_GetWidth", "World_GetLength" })
	local okH, height = _tryAny({ "World_GetHeight", "World_GetLength" })
	-- Fall back to a conservative default so zone layout still produces
	-- something usable on a map where the query fails.
	return (okW and width) or 400, (okH and height) or 400
end

function TD_API.MakePosition(x, y, z)
	local ok, pos = _try("World_Pos", x, y, z)
	if ok and pos ~= nil then
		return pos
	end
	-- Plain table fallback; the engine generally accepts {x,y,z} shaped
	-- positions in most calls that take a Position.
	return { x = x, y = y or 0, z = z }
end

-- Snap a position to walkable ground. Returns nil if the point is unusable
-- (water, cliff, off-map), so zone layout can skip it.
function TD_API.GetGroundPosition(pos)
	local ok, ground = _tryAny({ "World_GetSpawnablePosition", "Util_GetPositionFromTable" }, pos)
	if ok and ground ~= nil then
		return ground
	end
	return pos
end

-- Is this point over water? Used to classify zones as naval rather than to
-- exclude them, since water zones are capturable by warships.
-- Returns false when it cannot be determined, so an unreadable point is
-- treated as ordinary land.
function TD_API.IsPointOverWater(pos)
	local ok, water = _tryAny({ "World_IsPointOverWater", "World_IsPointUnderWater" }, pos)
	if ok and water ~= nil then
		return water == true or water == 1
	end
	return false
end

-- Can units of any kind occupy this point? Cliffs and map edges cannot hold
-- a zone at all; water can, and is reported separately by IsPointOverWater.
function TD_API.IsPointPlayable(pos)
	if TD_API.IsPointOverWater(pos) then
		-- Water is playable for naval units.
		return true
	end
	local ok, impassable = _try("World_IsPointOverImpassableTerrain", pos)
	if not ok then
		return true -- can't tell, so allow it
	end
	return not (impassable == true or impassable == 1)
end

-- Where a player begins the match. Used to give each player the zone on
-- their doorstep at match start.
--
-- Falls back to the position of the player's first entity (their Town
-- Centre, in practice) when no explicit starting position is exposed, and
-- returns nil when neither works so the caller can use a positionless
-- assignment instead.
function TD_API.GetPlayerStartPosition(player)
	local ok, pos = _tryAny(
		{ "Player_GetStartingPosition", "Player_GetInitialPosition", "Player_GetTownCenterPosition" },
		player
	)
	if ok and pos ~= nil then
		return pos
	end

	-- Fallback: ask for the player's entities and take the first one's
	-- position. At match start that is the Town Centre.
	local gotGroup, egroup = _tryAny({ "Player_GetEntities", "Player_GetAllEntities" }, player)
	if gotGroup and egroup ~= nil then
		local gotEntity, entity = _try("EGroup_GetEntityAt", egroup, 1)
		if gotEntity and entity ~= nil then
			local gotPos, entityPos = _try("Entity_GetPosition", entity)
			if gotPos and entityPos ~= nil then
				return entityPos
			end
		end
	end

	return nil
end

-----------------------------------------------------------------------------
-- UNIT PRESENCE
--
-- This is the hot path: called once per zone per scan tick. Keep it cheap.
-----------------------------------------------------------------------------

-- Number of a player's squads within radius of pos.
-- Returns 0 on any failure so a broken query never hands someone a zone.
function TD_API.CountPlayerSquadsNear(player, pos, radius)
	local ok, sgroup = _tryAny(
		{ "Player_GetSquadsNearPoint", "World_GetSquadsNearPoint" },
		player, pos, radius
	)
	if not ok or sgroup == nil then
		return 0
	end
	local okCount, count = _try("SGroup_CountSpawned", sgroup)
	if not okCount or count == nil then
		local okTotal, total = _try("SGroup_Count", sgroup)
		return (okTotal and total) or 0
	end
	return count
end

-- Number of a player's squads inside a SQUARE CELL centred on pos.
--
-- Zones tile the map as squares, but the engine's spatial query is circular,
-- so this asks for everything within the cell's circumradius and then keeps
-- only what is actually inside the rectangle. Without that filter a unit
-- standing in a neighbouring cell's corner would be counted in both, and
-- with cells sharing every edge that is a constant occurrence rather than a
-- rare one.
--
-- If the engine will not let us walk the group and read positions, this
-- falls back to the raw circular count and says so once. The mode still
-- works; captures just bleed slightly across cell corners.
local _rectFallbackWarned = false

function TD_API.CountPlayerSquadsInCell(player, pos, halfW, halfH)
	local circumradius = math.sqrt(halfW * halfW + halfH * halfH)

	local ok, sgroup = _tryAny(
		{ "Player_GetSquadsNearPoint", "World_GetSquadsNearPoint" },
		player, pos, circumradius
	)
	if not ok or sgroup == nil then
		return 0
	end

	local okCount, total = _try("SGroup_CountSpawned", sgroup)
	if not okCount or total == nil or total == 0 then
		return 0
	end

	-- Exact path: walk the group and test each squad against the rectangle.
	if type(_G["SGroup_GetSpawnedSquadAt"]) == "function" then
		local inside, walked = 0, true
		for i = 1, total do
			local gotSquad, squad = pcall(_G["SGroup_GetSpawnedSquadAt"], sgroup, i)
			if not gotSquad or squad == nil then
				walked = false
				break
			end
			local squadPos = TD_API.GetUnitPosition(squad)
			if squadPos == nil then
				walked = false
				break
			end
			if math.abs(squadPos.x - pos.x) <= halfW
				and math.abs(squadPos.z - pos.z) <= halfH then
				inside = inside + 1
			end
		end
		if walked then
			return inside
		end
	end

	if not _rectFallbackWarned then
		_rectFallbackWarned = true
		_warn("SGroup_GetSpawnedSquadAt (square-cell test falling back to "
			.. "circular; captures will bleed across cell corners)")
	end
	return total
end

-----------------------------------------------------------------------------
-- RESOURCES
-----------------------------------------------------------------------------

-- Resource type constants, with fallbacks if the engine globals are absent.
function TD_API.ResourceTypes()
	return {
		food  = _G["RT_Food"]  or 0,
		wood  = _G["RT_Wood"]  or 1,
		gold  = _G["RT_Gold"]  or 2,
		stone = _G["RT_Stone"] or 3,
	}
end

function TD_API.AddResource(player, resourceType, amount)
	if amount == nil or amount <= 0 then
		return
	end
	_tryAny({ "Player_AddResource", "Player_GiveResource" }, player, resourceType, amount)
end

-- A player's current stock of one resource.
function TD_API.GetResource(player, resourceType)
	local ok, amount = _tryAny(
		{ "Player_GetResource", "Player_GetResourceAmount" },
		player, resourceType
	)
	if ok and type(amount) == "number" then
		return amount
	end
	return 0
end

-- Lifetime total of a resource GATHERED by a player, if the engine exposes
-- such a stat. This is what the income boost really wants to measure.
--
-- Returns (totals, isCumulative):
--   isCumulative == true  -> totals only ever rise; spending does not affect
--                            them, and resources we grant are not counted.
--   isCumulative == false -> totals are current stock, which falls when the
--                            player spends. The caller must compensate.
--
-- The distinction matters: with cumulative stats the boost measures real
-- gathering exactly. With stock deltas it under-reads whenever a player
-- spends more than they mine during an interval, which in AoE4 is most of
-- the time. td_income.scar handles the fallback case explicitly.
function TD_API.GetGatheredTotals(player)
	local types = TD_API.ResourceTypes()

	-- Preferred: a cumulative gathered stat.
	for _, fnName in ipairs({ "Player_GetResourceGathered", "Player_GetTotalResourceGathered" }) do
		if type(_G[fnName]) == "function" then
			local totals, allOk = {}, true
			for key, rtype in pairs(types) do
				local ok, value = pcall(_G[fnName], player, rtype)
				if ok and type(value) == "number" then
					totals[key] = value
				else
					allOk = false
					break
				end
			end
			if allOk then
				return totals, true
			end
		end
	end

	-- Fallback: current stock.
	local totals = {}
	for key, rtype in pairs(types) do
		totals[key] = TD_API.GetResource(player, rtype)
	end
	return totals, false
end

-----------------------------------------------------------------------------
-- PRESENTATION
-----------------------------------------------------------------------------

function TD_API.ShowMessage(text)
	local shown = select(1, _tryAny(
		{ "UI_SystemMessageShow", "Game_ShowNotification", "UI_CreateEventCue" },
		text
	))
	if not shown then
		print("[TerritoryDomination] " .. tostring(text))
	end
end

-----------------------------------------------------------------------------
-- UNIT SPAWNING AND HEALTH
--
-- Used for kings. Everything here is best-effort: if spawning fails the
-- mode logs it and plays on without kings rather than refusing to start.
-----------------------------------------------------------------------------

-- Spawn one unit of `blueprint` for `player` at `pos`.
-- Returns a handle (squad or entity) or nil.
function TD_API.SpawnUnit(player, blueprint, pos)
	-- Resolve the blueprint name to whatever handle the spawn call wants.
	local bp = blueprint
	local okBP, resolved = _tryAny({ "BP_GetSquadBlueprint", "BP_GetEntityBlueprint" }, blueprint)
	if okBP and resolved ~= nil then
		bp = resolved
	end

	local ok, handle = _tryAny(
		{ "Squad_CreateAndSpawnToward", "Util_CreateSquads", "Squad_Create", "Entity_Create" },
		player, bp, pos
	)
	if ok and handle ~= nil then
		return handle
	end
	_warn("SpawnUnit(" .. tostring(blueprint) .. ")")
	return nil
end

-- Is a spawned unit still alive? Returns true when it cannot be determined,
-- so an unreadable handle never silently eliminates a player.
function TD_API.IsUnitAlive(handle)
	if handle == nil then
		return false
	end

	local ok, alive = _tryAny(
		{ "Squad_IsAlive", "Entity_IsAlive", "Squad_IsValid", "Entity_IsValid" },
		handle
	)
	if ok and alive ~= nil then
		return alive == true or alive == 1
	end

	-- Fall back to a population count, which reads as 0 once the unit dies.
	local okCount, count = _tryAny({ "SGroup_CountSpawned", "Squad_Count" }, handle)
	if okCount and type(count) == "number" then
		return count > 0
	end

	return true
end

-- Current health as a fraction 0..1, or nil if unreadable.
function TD_API.GetUnitHealthFraction(handle)
	if handle == nil then
		return nil
	end
	local ok, fraction = _tryAny(
		{ "Squad_GetHealthPercentage", "Entity_GetHealthPercentage", "Squad_GetHealth" },
		handle
	)
	if ok and type(fraction) == "number" then
		-- Some engine calls report 0..100 rather than 0..1.
		if fraction > 1.0 then
			return fraction / 100
		end
		return fraction
	end
	return nil
end

function TD_API.GetUnitPosition(handle)
	if handle == nil then
		return nil
	end
	local ok, pos = _tryAny({ "Squad_GetPosition", "Entity_GetPosition" }, handle)
	if ok and pos ~= nil then
		return pos
	end
	return nil
end

-----------------------------------------------------------------------------
-- ZONE VISUALS
--
-- Three independent layers, each optional. A zone stays fully playable if
-- any or all of them fail to create -- they are presentation only, and the
-- capture logic never reads them back.
--
--   ground ring   : thin circle decal on the terrain at the zone boundary
--   centre marker : small decal at the zone centre
--   minimap blip  : dot on the minimap, coloured by owner
-----------------------------------------------------------------------------

-- Outline of a square cell on the ground. Returns a handle or nil.
-- Cells tile, so neighbouring outlines share an edge and the map reads as
-- one continuous lattice rather than a scatter of separate shapes.
function TD_API.CreateGroundRect(pos, halfW, halfH, thickness, colour, opacity)
	local ok, handle = _tryAny(
		{ "UI_CreateGroundDecalRect", "UI_CreateGroundDecal", "World_CreateDecal" },
		pos, halfW, halfH, thickness, colour, opacity
	)
	if ok then
		return handle
	end
	return nil
end

-- Small filled SQUARE at the cell centre. Returns a handle or nil.
-- Square rather than round: on a map made of square tiles a round marker is
-- the one shape that does not belong to the grid.
function TD_API.CreateCentreSquare(pos, halfSize, colour, opacity)
	local ok, handle = _tryAny(
		{ "UI_CreateGroundDecalRect", "UI_CreateGroundDecal", "World_CreateDecal",
		  "UI_CreatePositionDecorator" },
		pos, halfSize, halfSize, colour, opacity
	)
	if ok then
		return handle
	end
	return nil
end

-- A filled square on the MINIMAP covering the whole cell, not a dot.
--
-- This is what lets a player count territory at a glance: filled cells in
-- each player's colour turn the minimap into a territory readout, where a
-- scatter of small blips would only mark centres and tell you nothing about
-- how much ground anyone holds.
function TD_API.CreateMinimapTile(pos, halfW, halfH, colour, opacity)
	local ok, handle = _tryAny(
		{ "UI_CreateMinimapRect", "UI_CreateMinimapArea", "UI_CreateMinimapBlip",
		  "UI_CreateMinimapIcon", "Marker_Create" },
		pos, halfW, halfH, colour, opacity
	)
	if ok then
		return handle
	end
	return nil
end

-- Recolour any visual handle. Used when a zone changes owner.
function TD_API.SetVisualColour(handle, colour, opacity)
	if handle == nil then
		return
	end
	_tryAny(
		{ "UI_SetDecalColour", "UI_SetDecalColor", "UI_SetMinimapBlipColour", "Marker_SetColour" },
		handle, colour, opacity
	)
end

function TD_API.DestroyVisual(handle)
	if handle == nil then
		return
	end
	_tryAny({ "UI_DestroyDecal", "World_DestroyDecal", "UI_DestroyMinimapBlip", "Marker_Destroy" }, handle)
end

-- Standard player slot colours and, importantly, their NAMES. Players refer
-- to each other by colour -- "yellow has the middle" -- so every readout
-- this mode prints names the colour rather than a slot number.
TD_API.PlayerColours = {
	{ name = "Blue",   r =  70, g = 130, b = 220 },
	{ name = "Red",    r = 210, g =  70, b =  60 },
	{ name = "Green",  r =  80, g = 175, b =  90 },
	{ name = "Yellow", r = 225, g = 190, b =  70 },
	{ name = "Purple", r = 150, g = 110, b = 200 },
	{ name = "Teal",   r =  60, g = 170, b = 165 },
	{ name = "Orange", r = 220, g = 130, b =  60 },
	{ name = "Pink",   r = 205, g = 105, b = 165 },
}

local function _slotColour(player)
	local index = ((tonumber(player) or 1) - 1) % #TD_API.PlayerColours + 1
	return TD_API.PlayerColours[index]
end

-- A player's UI colour, so zone visuals match the colour players already
-- associate with each opponent. Falls back to this mode's own slot palette
-- rather than to white, so colours stay distinguishable either way.
function TD_API.GetPlayerColour(player)
	local ok, colour = _tryAny(
		{ "Player_GetUIColour", "Player_GetUIColor", "Player_GetTeamColour" },
		player
	)
	if ok and type(colour) == "table" and colour.r ~= nil then
		return colour
	end
	return _slotColour(player)
end

-- The NAME of a player's colour, for readouts. Tries the engine's own
-- colour name first in case the player picked a non-default colour.
function TD_API.GetPlayerColourName(player)
	local ok, name = _tryAny(
		{ "Player_GetUIColourName", "Player_GetColourName" },
		player
	)
	if ok and type(name) == "string" and name ~= "" then
		return name
	end
	return _slotColour(player).name
end

-- Persistent on-screen text, for the territory tally. Returns true if the
-- engine actually took it; the HUD falls back to chat messages if not.
function TD_API.SetHudText(id, text)
	local ok = select(1, _tryAny(
		{ "UI_SetPanelText", "UI_SetWorldPanelText", "UI_TitleSetText", "UI_SetHintText" },
		id, text
	))
	return ok
end

-----------------------------------------------------------------------------
-- KILL ATTRIBUTION
-----------------------------------------------------------------------------

-- Who eliminated this player, if the engine can say. Returns nil when it
-- cannot -- which is the common case, so td_zones keeps its own ledger of
-- who has been taking territory from whom as the primary mechanism.
function TD_API.GetPlayerKiller(player)
	local ok, killer = _tryAny(
		{ "Player_GetLastAttacker", "Player_GetDefeatedBy", "Player_GetKiller" },
		player
	)
	if ok and killer ~= nil then
		return killer
	end
	return nil
end

-----------------------------------------------------------------------------
-- MATCH END
-----------------------------------------------------------------------------

function TD_API.DeclareWinner(player)
	local ok = select(1, _tryAny(
		{ "World_SetPlayerWin", "Player_SetWin", "World_SetTeamWin" },
		player
	))
	if not ok then
		TD_API.ShowMessage(TD_API.GetPlayerName(player) .. " wins!")
	end
end

function TD_API.EliminatePlayer(player)
	_tryAny({ "World_SetPlayerLose", "Player_SetDefeated" }, player)
end
