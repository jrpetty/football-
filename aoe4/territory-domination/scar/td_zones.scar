-----------------------------------------------------------------------------
-- td_zones.scar
--
-- Zone layout, ownership, capture mechanics and conquest inheritance.
--
-- A zone is a circular area with an owner (or nil for neutral), a value
-- (how strongly it boosts income), and per-player capture progress.
--
-- This file also keeps the CONQUEST LEDGER: a running tally of how much
-- territory each player has taken from each other player. When someone is
-- eliminated, that ledger decides who inherits their zones. See
-- TD_Zones.GetConqueror for why it works this way.
-----------------------------------------------------------------------------

TD_Zones = {
	list = {},
	-- Round-robin position for staggered scanning on large maps.
	scanCursor = 1,
	-- Grid dimensions and a col:row index, so neighbours are a lookup.
	cols = 0, rows = 0, byCell = {},
	-- ledger[victim][taker] = number of zones taken from victim by taker
	ledger = {},
	-- Mean raw weight before normalisation. Kept for diagnostics; after
	-- Build() every zone.weight is already divided through by it, so an
	-- average zone is worth exactly boostPerZone.
	averageValue = 1,
}

-----------------------------------------------------------------------------
-- LAYOUT
-----------------------------------------------------------------------------

-- Choose grid dimensions (cols x rows) for a map of this size.
--
-- Two things are traded off: landing near the target zone count, and cells
-- coming out square. The grid shape has to be derived from the MAP's aspect
-- ratio, not from the target count alone -- picking cols and rows by count
-- and then squaring the cells afterwards leaves a large strip of the map
-- outside the grid entirely, which defeats the point of tiling it.
--
-- Squareness is weighted at twice the target count so it decisively wins
-- near-ties rather than losing them to floating-point noise: on a square map
-- a 5x4 grid hits the target count exactly while a 4x4 is two zones short,
-- and the two scored within 1e-15 of each other until this weighting made
-- the preference explicit.
local function _chooseGrid(target, width, height)
	local bestCols, bestRows, bestScore = 2, 2, math.huge
	local aspectWeight = TD_Config.squareCells and (target * 2) or 0

	for cols = 2, 12 do
		for rows = 2, 12 do
			local stepX, stepZ = width / cols, height / rows
			local squareness = math.abs(stepX / stepZ - 1)
			local score = math.abs(cols * rows - target) + squareness * aspectWeight
			if score < bestScore then
				bestCols, bestRows, bestScore = cols, rows, score
			end
		end
	end

	return bestCols, bestRows
end

-- Continuous zone weight from how far a zone sits from the map centre,
-- where t is 0 for the innermost zone and 1 for the outermost.
--
-- t is scaled against the furthest zone that ACTUALLY EXISTS, not against
-- the map's half-diagonal. No grid cell ever lands in the far corner of the
-- map -- cells are inset by the edge margin and sit at cell centres -- so
-- measuring against the theoretical maximum squeezed every zone into the
-- middle of the configured band and all but erased the centre premium.
local function _weightForDistance(t)
	return TD_Config.centreZoneWeight
		+ (TD_Config.edgeZoneWeight - TD_Config.centreZoneWeight) * t
end

-- Bucket a normalised weight into a display tier, 1 (poorest) upward.
-- Cosmetic only; the income boost always uses the exact weight.
local function _displayTier(weight, minWeight, maxWeight)
	local tiers = TD_Config.displayTiers
	if maxWeight <= minWeight then
		return 1
	end
	local t = (weight - minWeight) / (maxWeight - minWeight)
	return math.min(tiers, math.floor(t * tiers) + 1)
end

-- How many zones this map should carry. See the ZONE COUNT note in
-- td_config for why it is the larger of area and per-player figures.
function TD_Zones.TargetZoneCount(width, height, playerCount)
	if TD_Config.zoneCountOverride ~= nil then
		return TD_Config.zoneCountOverride
	end

	local referenceArea = TD_Config.referenceMapSize * TD_Config.referenceMapSize
	local byArea = TD_Config.referenceZoneCount * ((width * height) / referenceArea)
	local byPlayers = (playerCount or 2) * TD_Config.zonesPerPlayer

	local target = math.max(byArea, byPlayers)
	return math.max(TD_Config.minZoneCount,
		math.min(TD_Config.maxZoneCount, math.floor(target + 0.5)))
end

function TD_Zones.Build(playerCount)
	TD_Zones.list = {}
	TD_Zones.ledger = {}
	TD_Zones.scanCursor = 1

	local width, height = TD_API.GetMapDimensions()
	local margin = TD_Config.mapEdgeMargin
	local target = TD_Zones.TargetZoneCount(width, height, playerCount)
	local usableW = width * (1 - margin * 2)
	local usableH = height * (1 - margin * 2)
	local cols, rows = _chooseGrid(target, usableW, usableH)

	local usableWidth  = width  * (1 - margin * 2)
	local usableHeight = height * (1 - margin * 2)

	-- World coordinates are centred on origin.
	-- Cells divide the usable map exactly, so the grid covers it corner to
	-- corner with no leftover strip. Squareness is handled by _chooseGrid
	-- picking a grid shape that suits the map, not by trimming cells here.
	local stepX, stepZ = usableWidth / cols, usableHeight / rows
	local originX, originZ = -usableWidth / 2, -usableHeight / 2

	local skipped = 0
	local minDistance, maxDistance = math.huge, -math.huge
	for col = 0, cols - 1 do
		for row = 0, rows - 1 do
			local x = originX + stepX * (col + 0.5)
			local z = originZ + stepZ * (row + 0.5)
			local rawPos = TD_API.MakePosition(x, 0, z)
			local isWater = TD_API.IsPointOverWater(rawPos)

			-- Cell centres are NOT snapped to walkable ground. A square
			-- cell's position defines the tile's geometry, not a spot a unit
			-- must stand on; snapping would shift cells off the lattice and
			-- open gaps between neighbours that should share an edge.
			local pos = rawPos

			-- Every cell becomes a zone. Cells over cliffs are kept rather
			-- than dropped: dropping them would punch holes in a grid whose
			-- whole point is to tile the map. An impassable cell simply
			-- stays neutral because nobody can stand in it.
			local passable = TD_API.IsPointPlayable(pos)
			local include = TD_Config.includeWaterZones or not isWater

			if include then
				local index = #TD_Zones.list + 1
				local distance = math.sqrt(x * x + z * z)
				minDistance = math.min(minDistance, distance)
				maxDistance = math.max(maxDistance, distance)
				table.insert(TD_Zones.list, {
					index     = index,
					name      = (isWater and "Waters " or "Zone ") .. index,
					position  = pos,
					distance  = distance,
					isWater   = isWater,
					impassable = not passable,
					-- Grid coordinates and cell half-extents. Cells tile, so
					-- halfW/halfH are exactly half the spacing and one
					-- zone's edge is its neighbour's edge.
					col       = col,
					row       = row,
					halfW     = stepX / 2,
					halfH     = stepZ / 2,
					weight    = 1,  -- assigned below, once the spread is known
					value     = 1,  -- display tier, assigned below
					owner     = nil,
					contested = false,
					progress  = {},
					-- Cached so visuals only refresh when state actually
					-- changes, rather than every scan tick.
					visualState = "neutral",
				})
			else
				skipped = skipped + 1
			end
		end
	end

	-- Normalise weights so the average zone on THIS map is worth exactly
	-- boostPerZone, whatever shape the map turned out to be. Doing it after
	-- unplayable cells are dropped matters: a map that loses its whole
	-- centre to water would otherwise leave every surviving zone underpaid.
	if #TD_Zones.list > 0 then
		-- Spread weights across the full configured band using the real
		-- innermost and outermost zones as the endpoints.
		local span = maxDistance - minDistance
		local sum = 0
		for _, zone in ipairs(TD_Zones.list) do
			local t = (span > 0) and ((zone.distance - minDistance) / span) or 0
			zone.weight = _weightForDistance(t)
			sum = sum + zone.weight
		end
		TD_Zones.averageValue = sum / #TD_Zones.list

		local minWeight, maxWeight = math.huge, -math.huge
		for _, zone in ipairs(TD_Zones.list) do
			zone.weight = zone.weight / TD_Zones.averageValue
			minWeight = math.min(minWeight, zone.weight)
			maxWeight = math.max(maxWeight, zone.weight)
		end
		for _, zone in ipairs(TD_Zones.list) do
			zone.value = _displayTier(zone.weight, minWeight, maxWeight)
		end
	end

	TD_Visuals.CreateAll(TD_Zones.list)

	-- Index by grid coordinate so neighbours are a lookup, not a search.
	TD_Zones.cols, TD_Zones.rows = cols, rows
	TD_Zones.byCell = {}
	for _, zone in ipairs(TD_Zones.list) do
		TD_Zones.byCell[zone.col .. ":" .. zone.row] = zone
	end

	local waterCount, blockedCount = 0, 0
	for _, zone in ipairs(TD_Zones.list) do
		if zone.isWater then
			waterCount = waterCount + 1
		end
		if zone.impassable then
			blockedCount = blockedCount + 1
		end
	end

	print(string.format(
		"[TerritoryDomination] Built %d zones for %d players on a %.0fx%.0f map "
			.. "(target %d, %dx%d grid of %.0fx%.0f cells, %d water, %d impassable, %d skipped)",
		#TD_Zones.list, playerCount or 2, width, height,
		target, cols, rows, stepX, stepZ, waterCount, blockedCount, skipped
	))
	return #TD_Zones.list
end

-----------------------------------------------------------------------------
-- STARTING ZONES
--
-- Every player begins owning the zone nearest their base, already fully
-- captured.
--
-- Two things make this less trivial than "nearest wins". First, two players
-- who start close together can both be nearest to the same zone, so the
-- assignment has to be resolved globally rather than per player. Second, a
-- player whose base happens to sit near the map centre would otherwise open
-- with a materially bigger income boost than everyone else, through no
-- decision of their own -- so candidate zones are filtered toward average
-- weight before distance is considered.
-----------------------------------------------------------------------------

-- Cost of giving `zone` to a player starting at `start`. Lower is better.
--
-- Distance is the dominant term; weight drift only inflates it. That
-- ordering is deliberate: a fair zone the player cannot defend is worse
-- than a slightly richer or poorer zone on their doorstep.
-- Water zones cannot be a starting zone: a player handed a sea zone they
-- cannot reach until they have built a dock would open a boost behind
-- everyone else, through no decision of their own.
local function _canStartOn(zone)
	return not zone.isWater
end

local function _startCost(zone, start)
	local dx, dz = zone.position.x - start.x, zone.position.z - start.z
	local distance = math.sqrt(dx * dx + dz * dz)
	local bias = TD_Config.startingZoneFairnessBias or 0
	return distance * (1 + bias * math.abs(zone.weight - 1.0))
end

-- Claim a zone for a player as though they had captured it outright.
local function _grantZone(zone, player)
	zone.owner = player
	zone.contested = false
	zone.progress = { [player] = TD_Config.captureThreshold }
	zone.visualState = tostring(player)
	TD_Visuals.Refresh(zone)
end

-- Assign starting zones by spreading players around the rim, used when the
-- engine will not tell us where anyone actually starts. Picks the outermost
-- zones that are furthest apart by bearing, so nobody opens on top of a
-- neighbour or in the contested middle.
local function _assignWithoutPositions(players)
	local candidates = {}
	for _, zone in ipairs(TD_Zones.list) do
		if _canStartOn(zone) then
			table.insert(candidates, zone)
		end
	end
	-- Outermost first: rim starts are the conventional RTS layout.
	table.sort(candidates, function(a, b) return a.distance > b.distance end)

	local chosen = {}
	for _, player in ipairs(players) do
		local best, bestScore = nil, -math.huge
		for _, zone in ipairs(candidates) do
			if zone.owner == nil then
				-- Prefer zones far from every already-chosen start.
				local score = math.huge
				for _, taken in ipairs(chosen) do
					local dx = zone.position.x - taken.position.x
					local dz = zone.position.z - taken.position.z
					score = math.min(score, math.sqrt(dx * dx + dz * dz))
				end
				if score == math.huge then
					score = zone.distance  -- first pick: take the outermost
				end
				if score > bestScore then
					best, bestScore = zone, score
				end
			end
		end
		if best ~= nil then
			_grantZone(best, player)
			table.insert(chosen, best)
		end
	end
	return #chosen
end

-- Give each player the fairest zone near their start. Returns how many were
-- assigned.
function TD_Zones.AssignStartingZones(players)
	if not TD_Config.startingZonePerPlayer or #TD_Zones.list == 0 then
		return 0
	end

	local starts, haveAll = {}, true
	for _, player in ipairs(players) do
		local pos = TD_API.GetPlayerStartPosition(player)
		if pos == nil then
			haveAll = false
			break
		end
		starts[player] = pos
	end

	if not haveAll then
		print("[TerritoryDomination] Starting positions unavailable; "
			.. "spreading starting zones around the map rim instead.")
		return _assignWithoutPositions(players)
	end

	-- Every player/zone pairing, cheapest first. Assigning globally rather
	-- than per player stops two close starts from both claiming one zone
	-- and leaving the loser with whatever is left over.
	local pairs_ = {}
	for _, player in ipairs(players) do
		for _, zone in ipairs(TD_Zones.list) do
			if _canStartOn(zone) then
				table.insert(pairs_, {
					player = player,
					zone = zone,
					cost = _startCost(zone, starts[player]),
				})
			end
		end
	end
	table.sort(pairs_, function(a, b) return a.cost < b.cost end)

	local assignedPlayers, assigned = {}, 0
	for _, pair in ipairs(pairs_) do
		if not assignedPlayers[pair.player] and pair.zone.owner == nil then
			_grantZone(pair.zone, pair.player)
			assignedPlayers[pair.player] = true
			assigned = assigned + 1
			if assigned == #players then
				break
			end
		end
	end

	-- A player whose every nearby zone was taken still gets one, from
	-- whatever remains.
	if assigned < #players then
		for _, player in ipairs(players) do
			if not assignedPlayers[player] then
				for _, zone in ipairs(TD_Zones.list) do
					if zone.owner == nil and _canStartOn(zone) then
						_grantZone(zone, player)
						assignedPlayers[player] = true
						assigned = assigned + 1
						break
					end
				end
			end
		end
	end

	print(string.format("[TerritoryDomination] Assigned %d starting zones.", assigned))
	return assigned
end

-----------------------------------------------------------------------------
-- CONQUEST LEDGER
-----------------------------------------------------------------------------

local function _recordTake(victim, taker)
	if victim == nil or taker == nil or victim == taker then
		return
	end
	TD_Zones.ledger[victim] = TD_Zones.ledger[victim] or {}
	TD_Zones.ledger[victim][taker] = (TD_Zones.ledger[victim][taker] or 0) + 1
end

-- Who most plausibly killed this player.
--
-- Engine-level kill attribution for a whole PLAYER (as opposed to a unit) is
-- not reliably exposed, so the ledger is the primary mechanism: whoever has
-- taken the most territory from the victim is treated as their conqueror.
-- In practice that is the player who actually ground them down, which is the
-- intent of "when you kill someone you take their zones" -- and it cannot be
-- stolen by an opportunist who snipes the last building.
--
-- The engine's own attribution is consulted first in case it does work, but
-- only counts if that player is still alive.
function TD_Zones.GetConqueror(victim, players)
	local engineKiller = TD_API.GetPlayerKiller(victim)
	if engineKiller ~= nil and engineKiller ~= victim and TD_API.IsPlayerAlive(engineKiller) then
		return engineKiller
	end

	local tally = TD_Zones.ledger[victim]
	if tally == nil then
		return nil
	end

	local best, bestCount = nil, 0
	for taker, count in pairs(tally) do
		if TD_API.IsPlayerAlive(taker) and count > bestCount then
			best, bestCount = taker, count
		end
	end
	return best
end

-----------------------------------------------------------------------------
-- CAPTURE
-----------------------------------------------------------------------------

-- Presence in a zone: [player] = squad count, plus the clear leader (nil if
-- tied) and how many players are present at all.
local function _scanPresence(zone, players)
	local presence = {}
	local leader, leaderCount, presentCount = nil, 0, 0

	for _, player in ipairs(players) do
		if TD_API.IsPlayerAlive(player) then
			local count = TD_API.CountPlayerSquadsInCell(
				player, zone.position, zone.halfW, zone.halfH)
			if count > 0 then
				presence[player] = count
				presentCount = presentCount + 1
				if count > leaderCount then
					leader, leaderCount = player, count
				end
			end
		end
	end

	-- A tie for the lead means nobody is winning the capture.
	if leader ~= nil then
		for player, count in pairs(presence) do
			if player ~= leader and count == leaderCount then
				leader = nil
				break
			end
		end
	end

	return presence, leader, presentCount
end

-- `elapsed` is the time in seconds since THIS zone was last examined, which
-- is not necessarily one tick: large maps stagger zone scans across ticks.
-- Crediting by elapsed time rather than per tick is what keeps the 20 second
-- solo capture true at every zone count.
local function _updateZone(zone, players, elapsed)
	local presence, leader, presentCount = _scanPresence(zone, players)
	zone.contested = (presentCount > 1)

	if leader ~= nil then
		local gain = math.min(
			presence[leader] * TD_Config.captureRatePerSquad,
			TD_Config.captureRateCap
		) * elapsed
		zone.progress[leader] = (zone.progress[leader] or 0) + gain

		for player, value in pairs(zone.progress) do
			if player ~= leader then
				zone.progress[player] = math.max(0, value - gain)
			end
		end

		if zone.progress[leader] >= TD_Config.captureThreshold and zone.owner ~= leader then
			local previousOwner = zone.owner
			zone.owner = leader
			zone.progress[leader] = TD_Config.captureThreshold
			_recordTake(previousOwner, leader)
			return leader, previousOwner
		end
	elseif presentCount == 0 and TD_Config.captureDecayPerTick > 0 then
		-- Empty zone: challenger progress bleeds away, but an established
		-- owner keeps the zone until someone actively takes it.
		local decay = TD_Config.captureDecayPerTick * elapsed
		for player, value in pairs(zone.progress) do
			if player ~= zone.owner then
				zone.progress[player] = math.max(0, value - decay)
			end
		end
	end

	return nil, nil
end

-- Visual state key, so visuals refresh only on a real change.
local function _visualState(zone)
	return tostring(zone.owner or "neutral") .. (zone.contested and ":contested" or "")
end

-- Scan a slice of the zone list, round-robin across ticks, so the per-tick
-- cost stays bounded no matter how large the map is. Every zone is still
-- credited for the full time since it was last looked at.
function TD_Zones.Update(players, now)
	local total = #TD_Zones.list
	if total == 0 then
		return
	end

	local budget = TD_Config.zoneScanBudget or total
	local count = math.min(budget, total)

	for _ = 1, count do
		local zone = TD_Zones.list[TD_Zones.scanCursor]
		TD_Zones.scanCursor = (TD_Zones.scanCursor % total) + 1

		-- First look at a zone credits one tick rather than all of history.
		local elapsed = now - (zone.lastScan or (now - TD_Config.scanInterval))
		zone.lastScan = now

		local newOwner, previousOwner = _updateZone(zone, players, elapsed)

		if newOwner ~= nil then
			zone.visualState = _visualState(zone)
			TD_Visuals.PulseCapture(zone, now)

			if TD_Config.announceCaptures then
				if previousOwner == nil then
					TD_API.ShowMessage(string.format("%s has claimed %s",
						TD_API.GetPlayerName(newOwner), zone.name))
				else
					TD_API.ShowMessage(string.format("%s has taken %s from %s",
						TD_API.GetPlayerName(newOwner), zone.name,
						TD_API.GetPlayerName(previousOwner)))
				end
			end
		else
			-- Contest state can change without ownership changing.
			local state = _visualState(zone)
			if state ~= zone.visualState then
				zone.visualState = state
				TD_Visuals.Refresh(zone)
			end
		end
	end

	TD_Visuals.Update(now)
end

-- The four zones sharing an edge with this one. Cells tile, so adjacency is
-- pure grid arithmetic. Exposed because a square lattice makes fronts and
-- salients real things a player can see and a rule could use.
function TD_Zones.GetNeighbours(zone)
	local out = {}
	local offsets = { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }
	for _, o in ipairs(offsets) do
		local neighbour = TD_Zones.byCell[(zone.col + o[1]) .. ":" .. (zone.row + o[2])]
		if neighbour ~= nil then
			table.insert(out, neighbour)
		end
	end
	return out
end

-- How many of a zone's neighbours a player holds. A zone deep inside your
-- territory has four; one on the front line has fewer.
function TD_Zones.CountFriendlyNeighbours(zone, player)
	local count = 0
	for _, neighbour in ipairs(TD_Zones.GetNeighbours(zone)) do
		if neighbour.owner == player then
			count = count + 1
		end
	end
	return count
end

-- Total zone weight on the map, used to express the boost cap as a share of
-- the whole map rather than a fixed percentage.
function TD_Zones.TotalWeight()
	local total = 0
	for _, zone in ipairs(TD_Zones.list) do
		total = total + (TD_Config.valueScalesBoost and zone.weight or 1)
	end
	return total
end

-----------------------------------------------------------------------------
-- QUERIES
-----------------------------------------------------------------------------

-- How much income boost weight a player's zones are currently worth,
-- expressed in units of "average zones". Holding three typical zones returns
-- roughly 3, so the boost really is boostPerZone per zone.
--
-- With valueScalesBoost on, a centre zone counts for somewhat more than one
-- and an edge zone for somewhat less, but the mean is pinned at 1 so the
-- headline percentage stays honest.
--
-- Contested zones contribute nothing while contestBlocksIncome is set.
-- Returns (boostWeight, ownedCount, payingCount).
function TD_Zones.GetBoostWeight(player)
	local weight, owned, paying = 0, 0, 0
	for _, zone in ipairs(TD_Zones.list) do
		if zone.owner == player then
			owned = owned + 1
			if not (zone.contested and TD_Config.contestBlocksIncome) then
				paying = paying + 1
				weight = weight + (TD_Config.valueScalesBoost and zone.weight or 1)
			end
		end
	end
	return weight, owned, paying
end

function TD_Zones.CountOwned(player)
	local count = 0
	for _, zone in ipairs(TD_Zones.list) do
		if zone.owner == player then
			count = count + 1
		end
	end
	return count
end

-----------------------------------------------------------------------------
-- TRANSFER
-----------------------------------------------------------------------------

-- Hand every zone owned by `from` to `to`. Passing nil for `to` releases
-- them to neutral. Returns how many zones moved.
function TD_Zones.TransferZones(from, to, now)
	local moved = 0
	for _, zone in ipairs(TD_Zones.list) do
		if zone.owner == from then
			zone.owner = to
			zone.contested = false
			-- Inherited zones arrive fully captured, so the new owner does
			-- not have to walk over and re-take ground they just won.
			zone.progress = {}
			if to ~= nil then
				zone.progress[to] = TD_Config.captureThreshold
			end
			zone.visualState = _visualState(zone)
			TD_Visuals.PulseCapture(zone, now or 0)
			moved = moved + 1
		end
		-- The dead player's own progress everywhere else is void.
		zone.progress[from] = nil
	end
	return moved
end
