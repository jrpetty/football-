-----------------------------------------------------------------------------
-- territorydomination.scar
--
-- TERRITORY DOMINATION
--
-- The map is divided into roughly 20 zones. Holding a zone pays you both
-- resources and score every few seconds; zones near the centre of the map
-- pay substantially more than those on the edge. There is no conventional
-- win condition -- no wonder, no landmark race, no killing every last
-- villager. The first player to reach the score cap wins.
--
-- The design goal: make economy and combat the same action. You cannot boom
-- in a safe corner, because a safe corner is worth the least. You cannot
-- turtle on a lead, because holding the lead means holding contested ground.
-- Every fight is an economic decision and every economic decision is a fight.
--
-- Entry point. Loads the other modules and drives the rule scheduler.
-----------------------------------------------------------------------------

import("td_config.scar")
import("td_adapter.scar")
import("td_zones.scar")
import("td_score.scar")

TerritoryDomination = {
	players = {},
	started = false,
}

-----------------------------------------------------------------------------
-- MODULE REGISTRATION
--
-- AoE4 win conditions register with the Core module system, which then calls
-- the _OnInit / _Start hooks below at the right points in match setup.
-- If Core is unavailable the mod falls back to driving itself from
-- OnGameSetup, so it still runs in a plain scenario script.
-----------------------------------------------------------------------------

if type(Core_RegisterModule) == "function" then
	Core_RegisterModule("TerritoryDomination")
end

-- Called once when the match is being set up.
function TerritoryDomination_OnInit()
	TerritoryDomination.players = TD_API.GetPlayers()

	if #TerritoryDomination.players == 0 then
		print("[TerritoryDomination] No players found; mode will not start.")
		return
	end

	TD_Score.Init(TerritoryDomination.players)

	local zoneCount = TD_Zones.Build()
	if zoneCount == 0 then
		print("[TerritoryDomination] No playable zones could be placed; mode will not start.")
		return
	end

	print(string.format(
		"[TerritoryDomination] Initialised for %d players over %d zones, score cap %d.",
		#TerritoryDomination.players, zoneCount, TD_Config.scoreCap
	))
end

-- Called once when the match actually begins.
function TerritoryDomination_Start()
	if TerritoryDomination.started then
		return
	end
	if #TerritoryDomination.players == 0 or #TD_Zones.list == 0 then
		return -- init failed; don't start rules that will only spam errors
	end
	TerritoryDomination.started = true

	TD_API.ShowMessage(string.format(
		"Territory Domination: hold zones to earn score and resources. First to %d wins.",
		TD_Config.scoreCap
	))

	Rule_AddInterval(TerritoryDomination_CaptureScan, TD_Config.scanInterval)
	Rule_AddInterval(TerritoryDomination_IncomeTick, TD_Config.incomeInterval)

	if TD_Config.scoreAnnounceInterval > 0 then
		Rule_AddInterval(TerritoryDomination_AnnounceScores, TD_Config.scoreAnnounceInterval)
	end
end

-----------------------------------------------------------------------------
-- RULES
-----------------------------------------------------------------------------

-- Fast tick: who is standing where, and does any zone change hands.
function TerritoryDomination_CaptureScan()
	TD_Zones.Update(TerritoryDomination.players)
end

-- Slow tick: pay out resources and score, and check for a winner.
function TerritoryDomination_IncomeTick()
	local winner = TD_Score.Tick(TerritoryDomination.players)
	if winner ~= nil then
		TerritoryDomination_End(winner)
	end
end

function TerritoryDomination_AnnounceScores()
	TD_Score.Announce(TerritoryDomination.players)
end

-- A player leaving or being defeated releases their zones back to neutral,
-- so their territory becomes contestable rather than frozen.
function TerritoryDomination_OnPlayerDefeated(player)
	TD_Zones.ReleasePlayer(player)
	TD_API.ShowMessage(TD_API.GetPlayerName(player) .. " has been eliminated; their zones are now neutral.")
end

function TerritoryDomination_End(winner)
	Rule_RemoveGlobalEvent(TerritoryDomination_CaptureScan)
	Rule_RemoveGlobalEvent(TerritoryDomination_IncomeTick)
	Rule_RemoveGlobalEvent(TerritoryDomination_AnnounceScores)

	TD_Score.DeclareWinner(winner, TerritoryDomination.players)
end

-----------------------------------------------------------------------------
-- FALLBACK ENTRY POINT
--
-- Scenario scripts call OnGameSetup / OnInit directly rather than going
-- through Core. Only define these if nothing else already has.
-----------------------------------------------------------------------------

if type(Core_RegisterModule) ~= "function" then
	function OnInit()
		TerritoryDomination_OnInit()
		TerritoryDomination_Start()
	end
end
