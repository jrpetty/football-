-----------------------------------------------------------------------------
-- territorydomination.scar
--
-- TERRITORY DOMINATION
--
-- The map is divided into roughly 20 zones. Every zone you hold increases
-- your gather rate by 10% of what you are actually mining. The match runs
-- until one player is left standing -- no score cap, no timer.
--
-- When a player is eliminated, their zones do not revert to neutral: they
-- pass to whoever conquered them. Killing someone hands you their economy,
-- so every elimination accelerates the endgame instead of resetting it.
--
-- The design goal: economy and combat are the same action. Edge zones are
-- worth least, so booming in a safe corner is unprofitable. An enemy
-- standing in your zone freezes its boost immediately, so a cheap raid has
-- instant economic value. And because the boost is a percentage, zones stay
-- worth fighting over at every stage of the game.
-----------------------------------------------------------------------------

import("td_config.scar")
import("td_adapter.scar")
import("td_visuals.scar")
import("td_zones.scar")
import("td_income.scar")

TerritoryDomination = {
	players = {},
	alive = {},
	started = false,
	finished = false,
	elapsed = 0,
}

if type(Core_RegisterModule) == "function" then
	Core_RegisterModule("TerritoryDomination")
end

-----------------------------------------------------------------------------
-- SETUP
-----------------------------------------------------------------------------

function TerritoryDomination_OnInit()
	TerritoryDomination.players = TD_API.GetPlayers()

	if #TerritoryDomination.players == 0 then
		print("[TerritoryDomination] No players found; mode will not start.")
		return
	end

	TerritoryDomination.alive = {}
	for _, player in ipairs(TerritoryDomination.players) do
		TerritoryDomination.alive[player] = true
	end

	local zoneCount = TD_Zones.Build()
	if zoneCount == 0 then
		print("[TerritoryDomination] No playable zones placed; mode will not start.")
		return
	end

	TD_Zones.AssignStartingZones(TerritoryDomination.players)

	TD_Income.Init(TerritoryDomination.players)

	print(string.format(
		"[TerritoryDomination] Initialised for %d players over %d zones, %d%% boost per zone.",
		#TerritoryDomination.players, zoneCount,
		math.floor(TD_Config.boostPerZone * 100 + 0.5)
	))
end

function TerritoryDomination_Start()
	if TerritoryDomination.started then
		return
	end
	if #TerritoryDomination.players == 0 or #TD_Zones.list == 0 then
		return
	end
	TerritoryDomination.started = true

	TD_API.ShowMessage(string.format(
		"Territory Domination: every zone you hold adds %d%% to your gather rate. "
			.. "Eliminate a rival and you inherit their zones. Last player standing wins.",
		math.floor(TD_Config.boostPerZone * 100 + 0.5)
	))

	Rule_AddInterval(TerritoryDomination_CaptureScan, TD_Config.scanInterval)
	Rule_AddInterval(TerritoryDomination_GatherSample, TD_Config.gatherSampleInterval)
	Rule_AddInterval(TerritoryDomination_IncomePayout, TD_Config.incomeInterval)
	Rule_AddInterval(TerritoryDomination_EliminationCheck, TD_Config.eliminationCheckInterval)

	if TD_Config.standingsAnnounceInterval > 0 then
		Rule_AddInterval(TerritoryDomination_AnnounceStandings, TD_Config.standingsAnnounceInterval)
	end
end

-----------------------------------------------------------------------------
-- RULES
-----------------------------------------------------------------------------

-- Fast tick: who is standing where, does any zone change hands, settle pulses.
function TerritoryDomination_CaptureScan()
	TerritoryDomination.elapsed = TerritoryDomination.elapsed + TD_Config.scanInterval
	TD_Zones.Update(TerritoryDomination.players, TerritoryDomination.elapsed)
end

-- Medium tick: measure what each player is gathering.
function TerritoryDomination_GatherSample()
	TD_Income.Sample(TerritoryDomination.players)
end

-- Slow tick: pay the percentage boost.
function TerritoryDomination_IncomePayout()
	TD_Income.Payout(TerritoryDomination.players)
end

function TerritoryDomination_AnnounceStandings()
	TD_Income.Announce(TerritoryDomination.players)
end

-----------------------------------------------------------------------------
-- ELIMINATION AND CONQUEST
--
-- Standard AoE4 rules decide WHEN a player dies. This mode only decides what
-- becomes of their territory, and when the match is over.
-----------------------------------------------------------------------------

function TerritoryDomination_EliminationCheck()
	if TerritoryDomination.finished then
		return
	end

	for _, player in ipairs(TerritoryDomination.players) do
		if TerritoryDomination.alive[player] and not TD_API.IsPlayerAlive(player) then
			TerritoryDomination.alive[player] = false
			TerritoryDomination_OnPlayerDefeated(player)
		end
	end

	local survivors = {}
	for _, player in ipairs(TerritoryDomination.players) do
		if TerritoryDomination.alive[player] then
			table.insert(survivors, player)
		end
	end

	if #survivors <= 1 then
		TerritoryDomination_End(survivors[1])
	end
end

function TerritoryDomination_OnPlayerDefeated(player)
	TerritoryDomination.alive[player] = false

	local heldCount = TD_Zones.CountOwned(player)
	local conqueror = nil

	if TD_Config.inheritZonesOnKill then
		conqueror = TD_Zones.GetConqueror(player, TerritoryDomination.players)

		if conqueror == nil and not TD_Config.neutralOnUnknownKiller then
			-- Nobody identifiable took them down (they resigned, or dropped).
			-- Award their land to the strongest surviving player instead of
			-- letting it evaporate.
			local best, bestCount = nil, -1
			for _, other in ipairs(TerritoryDomination.players) do
				if other ~= player and TerritoryDomination.alive[other] then
					local count = TD_Zones.CountOwned(other)
					if count > bestCount then
						best, bestCount = other, count
					end
				end
			end
			conqueror = best
		end
	end

	local moved = TD_Zones.TransferZones(player, conqueror, TerritoryDomination.elapsed)

	if TD_Config.announceConquest and heldCount > 0 then
		if conqueror ~= nil then
			TD_API.ShowMessage(string.format(
				"%s has fallen. %s claims their %d zone%s.",
				TD_API.GetPlayerName(player),
				TD_API.GetPlayerName(conqueror),
				moved, moved == 1 and "" or "s"
			))
		else
			TD_API.ShowMessage(string.format(
				"%s has fallen. Their %d zone%s %s now unclaimed.",
				TD_API.GetPlayerName(player),
				moved, moved == 1 and "" or "s",
				moved == 1 and "is" or "are"
			))
		end
	end
end

function TerritoryDomination_End(winner)
	if TerritoryDomination.finished then
		return
	end
	TerritoryDomination.finished = true

	Rule_RemoveGlobalEvent(TerritoryDomination_CaptureScan)
	Rule_RemoveGlobalEvent(TerritoryDomination_GatherSample)
	Rule_RemoveGlobalEvent(TerritoryDomination_IncomePayout)
	Rule_RemoveGlobalEvent(TerritoryDomination_EliminationCheck)
	Rule_RemoveGlobalEvent(TerritoryDomination_AnnounceStandings)

	if winner ~= nil then
		TD_API.ShowMessage(string.format(
			"%s is the last power standing, holding %d of %d zones.",
			TD_API.GetPlayerName(winner),
			TD_Zones.CountOwned(winner),
			#TD_Zones.list
		))
		TD_API.DeclareWinner(winner)
	else
		TD_API.ShowMessage("No players remain.")
	end

	TD_Visuals.DestroyAll(TD_Zones.list)
end

-----------------------------------------------------------------------------
-- FALLBACK ENTRY POINT
--
-- Scenario scripts call OnInit directly rather than going through Core.
-----------------------------------------------------------------------------

if type(Core_RegisterModule) ~= "function" then
	function OnInit()
		TerritoryDomination_OnInit()
		TerritoryDomination_Start()
	end
end
