-----------------------------------------------------------------------------
-- td_config.scar
--
-- All tunables for Territory Domination in one place. Nothing here depends
-- on the engine, so it is safe to edit freely between playtests.
-----------------------------------------------------------------------------

TD_Config = {

	-----------------------------------------------------------------------
	-- ZONES
	-----------------------------------------------------------------------

	-- ZONE COUNT scales with the map rather than being fixed, so an 8 player
	-- map is not carved into the same handful of zones as a 1v1.
	--
	-- The target is the larger of two figures:
	--   * map area, against the reference below
	--   * zonesPerPlayer x the number of players
	-- then clamped. Taking the larger means a big 1v1 map still gets plenty
	-- of zones, and a crowded small map still gets enough to go round.
	--
	-- The layout is a grid, so the real count is the nearest grid that fits.
	-- Unusable cells (cliffs) are dropped, so expect slightly fewer.
	--
	-- Set zoneCountOverride to a number to ignore all of this and force one.
	zoneCountOverride = nil,

	-- Reference point for area scaling: a map this size gets this many
	-- zones. Calibrated so a standard 1v1 map lands on ~18 after cliffs are
	-- dropped, which is the density the mode was balanced at.
	referenceMapSize  = 400,
	referenceZoneCount = 20,

	-- Floor on zones per player, so a crowded map still has room to fight
	-- over. 9 keeps an 8 player game at the same zones-per-head as a 1v1.
	zonesPerPlayer = 9,

	-- Absolute bounds. The upper bound is a performance guard as much as a
	-- design one: every zone is checked against every player.
	minZoneCount = 8,
	maxZoneCount = 72,

	-- Radius in world units within which units count as holding a zone.
	zoneRadius = 20,

	-- Fraction of the map edge left free of zones. Keeps zones off the map
	-- border where units cannot path properly.
	mapEdgeMargin = 0.12,

	-- Place zones over water as well as land. Water zones are captured the
	-- same way as any other -- by having a unit sit in them -- which in
	-- practice means warships, so naval control becomes worth something.
	--
	-- Water zones are excluded from STARTING zone assignment regardless of
	-- this setting: a player handed a sea zone they cannot reach until they
	-- have built a dock would be starting a boost behind everyone else.
	includeWaterZones = true,

	-----------------------------------------------------------------------
	-- CAPTURE
	-----------------------------------------------------------------------

	-- Progress points needed to flip a zone from neutral/enemy to yours.
	captureThreshold = 200,

	-- Progress gained PER SECOND per unit present, up to the cap below.
	--
	-- With captureThreshold 200, 10 per unit means a SINGLE unit captures a
	-- zone in exactly 20 seconds. These rates are per second rather than per
	-- tick so that the figure holds however often zones actually get
	-- scanned -- which varies once a big map staggers its scans across
	-- ticks. Change these two together or the 20s drifts; balance_sim.lua
	-- prints the real number.
	captureRatePerSquad = 10,

	-- Maximum capture progress per second regardless of how many units you
	-- bring. Stops a 40-unit deathball from flipping zones instantly and
	-- keeps lone scouts and small raiding parties relevant.
	-- At 30, three units reach the cap: 20s solo, 10s with two, 6.7s with
	-- three or more. A deathball is three times faster than one unit, not
	-- forty times.
	captureRateCap = 30,

	-- Progress decayed per second on an uncontested zone nobody is standing
	-- in. Set to 0 to make captures permanent until contested.
	captureDecayPerTick = 2,

	-- If true, an enemy present in your zone freezes its income boost even
	-- before they have captured it. This is what makes raiding worthwhile.
	contestBlocksIncome = true,

	-- Give every player the zone nearest their starting position at match
	-- start, already fully captured. Without this the opening minutes are a
	-- scramble from zero, and a player whose start is far from any zone is
	-- quietly disadvantaged through no decision of their own.
	startingZonePerPlayer = true,

	-- How strongly starting-zone assignment prefers an average-weight zone
	-- over a merely closer one, so a player whose base happens to sit near
	-- the map centre does not open on a materially larger income boost.
	--
	-- This is a SOFT bias, not a filter. A hard "must be near average
	-- weight" rule shrinks the candidate pool until, at high player counts,
	-- somebody is stranded with a fair-but-distant zone they cannot defend
	-- -- which is a worse unfairness than the one it fixes. As a bias,
	-- distance always dominates and weight only breaks near-ties.
	--
	-- 0 picks the strictly nearest zone and ignores fairness entirely.
	-- 4.0 means a zone one full weight-unit off average is treated as
	-- though it were five times further away than it is.
	--
	-- 4.0 was chosen by sweeping the value (test/balance_sim.lua reports
	-- the same figures): on a crowded 8-player layout it cuts the spread in
	-- starting income from 74% to 35% without pushing anyone's starting
	-- zone any further from their base, and higher values buy nothing more.
	startingZoneFairnessBias = 4.0,

	-- Seconds between capture/ownership scan ticks.
	scanInterval = 1.0,

	-- Most zones to examine in a single tick. Every zone queries every
	-- player, so on a 72 zone 8 player map an unbudgeted scan would be 576
	-- spatial queries per second. Above this budget zones are scanned
	-- round-robin across consecutive ticks instead.
	--
	-- This does NOT change capture speed: progress is credited by elapsed
	-- time since that zone was last looked at, so a zone scanned every third
	-- tick gains three ticks' worth. It only delays how quickly a newly
	-- arrived enemy is noticed, by at most (zones / budget) ticks.
	zoneScanBudget = 24,

	-----------------------------------------------------------------------
	-- INCOME BOOST
	--
	-- Zones do not hand out flat resources. Each zone you hold increases
	-- your gather rate by a percentage of whatever you actually collected
	-- over the last interval. A player with a big economy gets more out of
	-- a zone than a player with a small one, so zones are worth taking at
	-- every stage of the game rather than only when you are behind.
	-----------------------------------------------------------------------

	-- Income boost granted per zone held, as a fraction.
	-- 0.10 = each zone adds 10% to what you gathered this interval.
	-- Holding 5 zones therefore pays +50% on everything you mined.
	boostPerZone = 0.10,

	-- Ceiling on total boost, as a FRACTION OF THE WHOLE MAP'S boost rather
	-- than an absolute percentage. 0.75 means the boost stops growing once
	-- you hold three quarters of the map's total zone weight.
	--
	-- This has to scale with zone count. A fixed +200% cap was fine at 18
	-- zones, where it could never bind; on a 72 zone map it would bind at a
	-- 28% map share, so every zone past the twentieth would be worthless and
	-- the whole mode would stop working in 4v4.
	-- Set to nil for no cap at all.
	maxTotalBoostFraction = 0.75,

	-- Seconds between income boost payouts. The boost is described as a
	-- per-minute figure, so 60 keeps the display and the mechanic honest.
	incomeInterval = 60.0,

	-- Seconds between gather-rate samples. This is NOT the payout interval;
	-- it is how often the mode measures what you are mining.
	--
	-- Sampling frequently matters when the engine only exposes current
	-- resource stock rather than a lifetime-gathered stat. Gathering is a
	-- continuous trickle while spending happens in discrete lumps, so
	-- frequent samples catch the trickle between purchases. Sampling only
	-- once per payout would score a player as having gathered nothing on any
	-- minute they spent more than they mined -- which in AoE4 is most of
	-- them. See td_income.scar for the full explanation.
	gatherSampleInterval = 5.0,

	-- Whether centre zones are worth more boost than edge zones.
	--
	-- Zone values are NORMALISED against the map average before being
	-- applied, so an average zone is always worth exactly boostPerZone. A
	-- centre zone comes out somewhat above that and an edge zone somewhat
	-- below, typically a 1.3x / 0.7x spread. That keeps the pull toward the
	-- middle without inflating the headline number -- scaling by raw value
	-- instead would have made "10% per zone" mean 30% in practice.
	--
	-- Set false to make every zone a flat boostPerZone regardless of
	-- position; centre zones then matter tactically but not economically.
	valueScalesBoost = true,

	-----------------------------------------------------------------------
	-- ZONE WEIGHTING
	--
	-- Zones closer to the map centre are worth more, which is what pulls
	-- players into conflict instead of farming a safe corner.
	--
	-- Weight is a continuous multiplier on boostPerZone, interpolated by
	-- distance from the map centre and then normalised so the average zone
	-- across the map comes out at exactly 1.0. A continuous weight matters
	-- here: rounding zone worth to integer tiers collapses most of the map
	-- into a single tier and leaves edge zones at half value, which made
	-- rim zones barely worth taking.
	-----------------------------------------------------------------------

	-- Weight at the exact map centre and at the outer edge. The gap between
	-- them is how hard players are pulled toward the middle. Keep both
	-- within about 0.6-1.5 so no zone becomes worthless or decisive alone.
	centreZoneWeight = 1.40,
	edgeZoneWeight   = 0.70,

	-- Number of display tiers zones are bucketed into for messages and
	-- visuals. Purely cosmetic; the boost always uses the exact weight.
	displayTiers = 3,

	-----------------------------------------------------------------------
	-- CONQUEST
	--
	-- The match runs until one player remains. Standard AoE4 elimination
	-- rules decide when a player dies; this mode decides what happens to
	-- their territory afterwards.
	-----------------------------------------------------------------------

	-- When a player is eliminated, their zones transfer to whoever killed
	-- them rather than reverting to neutral. Conquest compounds: taking
	-- someone out hands you their whole economy.
	inheritZonesOnKill = true,

	-- If the killer cannot be identified, fall back to releasing the dead
	-- player's zones to neutral instead of giving them to no one.
	-- Set false to award them to the highest-value holder instead.
	neutralOnUnknownKiller = true,

	-- Seconds between checks for players having been eliminated.
	eliminationCheckInterval = 5.0,

	-----------------------------------------------------------------------
	-- KINGS
	--
	-- Every player gets a king at their starting position. Lose your king
	-- and you are eliminated, which hands your zones to your conqueror the
	-- same as any other defeat.
	--
	-- This is the one rule here that was inferred rather than specified.
	-- "Every player has a king" in an RTS conventionally means regicide, and
	-- it is the only reading that does anything in a last-man-standing mode.
	-- Set kingDeathEliminates = false to have kings be purely decorative.
	-----------------------------------------------------------------------

	kings = {
		-- Spawn a king for every player at match start.
		enabled = true,

		-- Losing your king eliminates you immediately.
		kingDeathEliminates = true,

		-- The unit blueprint to spawn.
		--
		-- IMPORTANT: Age of Empires IV has no stock "king" unit, so this is
		-- a placeholder that WILL need changing in the Essence Editor. Pick
		-- a real blueprint: the Mongol Khan is the closest thing to a hero
		-- unit in the base game, or use any distinctive unit and rely on the
		-- mode treating it as a king. The startup log reports whether the
		-- spawn succeeded.
		blueprint = "unit_king_1",

		-- How far from the player's starting position to place the king, in
		-- world units. Far enough not to spawn inside the Town Centre.
		spawnOffset = 8,

		-- Warn a player once when their king is below this fraction of its
		-- health, so a regicide loss is never a silent surprise.
		lowHealthWarning = 0.35,

		-- Announce to everyone when a king dies.
		announceDeath = true,
	},

	-----------------------------------------------------------------------
	-- VISUALS
	--
	-- Zones must be readable at a glance without cluttering the screen.
	-- The defaults are deliberately restrained: a thin ground ring and a
	-- small minimap dot, nothing that obscures units or terrain.
	-----------------------------------------------------------------------

	visuals = {
		-- Master switch for all zone visuals.
		enabled = true,

		-- Thin ring decal on the ground at the zone boundary.
		showGroundRing = true,

		-- Ring line thickness in world units. Keep this small.
		ringThickness = 0.6,

		-- Ring opacity, 0..1. Low by design -- the ring should read as a
		-- boundary, not as a spotlight.
		ringOpacity = 0.35,

		-- Small marker at the zone centre. Set false if the ring alone is
		-- enough and you want the ground completely clear.
		showCentreMarker = true,

		-- Centre marker scale multiplier.
		centreMarkerScale = 0.7,

		-- Minimap dot for each zone, coloured by owner.
		showMinimapBlip = true,

		-- Minimap dot size multiplier. Small enough not to hide units.
		minimapBlipScale = 0.6,

		-- Pulse the ring briefly when a zone changes hands, then settle
		-- back to the resting opacity. Draws the eye once rather than
		-- permanently.
		pulseOnCapture = true,
		pulseDuration = 2.0,

		-- Opacity used while a zone is contested, so a fight over a zone
		-- is visible without being loud.
		contestedOpacity = 0.55,

		-- Neutral zone colour, as RGB 0..255. Deliberately pale grey so
		-- unclaimed zones recede and owned ones stand out.
		neutralColour = { r = 160, g = 160, b = 160 },
	},

	-----------------------------------------------------------------------
	-- PRESENTATION
	-----------------------------------------------------------------------

	-- Seconds between standings broadcasts. 0 disables them.
	standingsAnnounceInterval = 90.0,

	-- Announce when a zone changes hands.
	announceCaptures = true,

	-- Announce when a player is eliminated and their zones are inherited.
	announceConquest = true,
}
