# Easiest: use the dashboard's API Keys page (or `node src/cli.ts keys setup`), which writes this file for you.
# Copy to .env (never commit it) and fill in the providers you want to benchmark.
# Only models whose provider key is present can run; the Random Baseline needs no key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=

# Optional
# PORT=7777
# GAUNTLET_HOST=127.0.0.1          # use 0.0.0.0 only on a trusted network
# GAUNTLET_DATA_DIR=./data         # where runs are stored
# GAUNTLET_CHROMIUM=/path/to/chrome  # headless browser for game/SVG checks
# GAUNTLET_NO_BROWSER=1            # skip browser checks entirely
