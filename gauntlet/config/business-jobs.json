{
  "version": "1.0.0",
  "title": "Which model for this job?",
  "tagline": "Pick a job your business does. See which AI models can do it, how often they get it wrong, what it costs and how fast it is.",
  "rule": {
    "minAnswers": 10,
    "requireEveryTest": true,
    "ready": { "minMean": 0.95, "minCiLow": 0.9, "allowSevere": false },
    "check": { "minMean": 0.85 },
    "bootstrap": { "iterations": 1000, "seed": 77 }
  },
  "jobs": [
    {
      "id": "screen-applicants",
      "short": "Applicants",
      "name": "Screen job applicants",
      "what": "Reads CVs, checks each one against the job's must-haves and draws up a fair shortlist.",
      "icon": "persona",
      "tests": ["work.cv-shortlist", "work.cv-read", "work.recruiter"]
    },
    {
      "id": "supplier-invoices",
      "short": "Invoices",
      "name": "Check supplier invoices before paying",
      "what": "Matches each invoice to its order and delivery, then says pay, hold or reject, and how much.",
      "icon": "receipt",
      "tests": ["work.invoice-matching", "work.invoice-read", "work.delivery-note", "work.invoices-ladder", "work.accounts-clerk"]
    },
    {
      "id": "payroll",
      "short": "Payroll",
      "name": "Check payroll",
      "what": "Checks every payslip's tax, National Insurance, pension and net pay, and corrects the wrong ones.",
      "icon": "dollar",
      "tests": ["work.payroll-check", "work.payroll-ladder"]
    },
    {
      "id": "expenses",
      "short": "Expenses",
      "name": "Expense claims",
      "what": "Checks staff expense claims against your policy: caps, receipts, alcohol, duplicates and mileage.",
      "icon": "percent",
      "tests": ["work.expense-audit", "work.expenses-ladder"]
    },
    {
      "id": "month-end",
      "short": "Month end",
      "name": "Bank reconciliation and month end",
      "what": "Ties the bank statement to your books line by line, finds the differences and closes the month.",
      "icon": "scale",
      "tests": ["work.bank-reconciliation", "work.reconciliation-ladder", "work.month-end"]
    },
    {
      "id": "customer-support",
      "short": "Support",
      "name": "Customer support",
      "what": "Tags tickets, decides refunds by your policy, writes the replies and works the helpdesk queue.",
      "icon": "mic",
      "tests": ["work.ticket-tag", "work.support-refunds", "work.support-replies", "work.support-ladder", "work.helpdesk-agent", "work.support-week"]
    },
    {
      "id": "inbox-admin",
      "short": "Inbox & admin",
      "name": "Inbox and admin assistant",
      "what": "Sorts the inbox, picks out your jobs and deadlines, and runs the diary and errands with tools.",
      "icon": "ask",
      "tests": ["work.email-actions", "work.inbox-triage", "work.assistant", "work.assistant-hard", "work.office-week"]
    },
    {
      "id": "contracts",
      "short": "Contracts",
      "name": "Contracts",
      "what": "Compares two versions of a contract and lists every change that matters, clause by clause.",
      "icon": "gavel",
      "tests": ["work.contract-redline", "work.contract-ladder"]
    },
    {
      "id": "customer-data",
      "short": "Customer data",
      "name": "Customer data clean-up",
      "what": "Finds the same customer entered twice in your lists, merges them and keeps the right details.",
      "icon": "connect4",
      "tests": ["work.crm-dedupe", "work.crm-ladder"]
    },
    {
      "id": "database-questions",
      "short": "Data questions",
      "name": "Answer questions from your database",
      "what": "Answers business questions by writing database queries or reading a spreadsheet, with exact numbers.",
      "icon": "grid",
      "tests": ["work.sql-questions", "work.sql-hard", "work.sql-ladder", "work.sheet-lookup"]
    },
    {
      "id": "scheduling",
      "short": "Rotas",
      "name": "Scheduling and rotas",
      "what": "Finds meeting slots that suit everyone and builds staff rotas that keep every rule.",
      "icon": "clock",
      "tests": ["work.meeting-scheduler", "work.shift-rota"]
    },
    {
      "id": "stock-deliveries",
      "short": "Stock",
      "name": "Stock and deliveries",
      "what": "Checks deliveries, decides what to reorder, plans van routes and runs the warehouse for a week.",
      "icon": "route",
      "tests": ["work.stock-reorder", "work.delivery-routes", "work.delivery-note", "work.warehouse-week"]
    },
    {
      "id": "board-reporting",
      "short": "Board pack",
      "name": "Board reporting",
      "what": "Works out the figures for the board pack from raw data, and investigates the numbers with tools.",
      "icon": "chart",
      "tests": ["work.board-report", "work.analyst-agent"]
    }
  ],
