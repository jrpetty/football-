{
  "name": "rigcheck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "RIGCHECK \u2014 build comparison & performance modelling platform",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "harvest": "tsx scripts/harvest.ts",
    "parse": "tsx scripts/parse.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "import:manual": "tsx scripts/import-manual.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "validate": "tsx scripts/validate.ts",
    "coverage": "tsx scripts/coverage.ts",
    "gate": "npm run import:manual && npm run validate",
    "audit": "tsx scripts/audit.ts",
    "build:single": "vite build && node scripts/build-single.mjs",
    "import:prices": "tsx scripts/import-prices.ts",
    "a11y": "node scripts/a11y-audit.mjs",
    "fuzz:sticky": "node scripts/sticky-fuzz.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright": "^1.49.1",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "vitest": "^2.1.1"
  }
}
