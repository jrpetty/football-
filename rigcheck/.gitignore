node_modules/
dist/
*.local

# Raw harvest cache: permanent on disk, never committed (large, regenerable).
# Parsed output under data/ IS committed.
cache/raw/

# TypeScript incremental build cache
*.tsbuildinfo

# Throwaway browser-driving scripts. Playwright resolves its import from the
# project directory, so verification probes have to be written here rather than
# in a temp dir; they are scratch, never deliverables.
probe.mjs
__probe.mjs
vrfy.cjs
*.probe.mjs
probe/

# Screenshots taken while checking a change in a real browser.
*.png
!public/**/*.png

# Generated posting calendar and the daily drop folder. rotation.json and
# posted.json beside them are the inputs and the record, and are committed.
marketing/calendar/
marketing/drop/
