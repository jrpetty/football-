# ---------------------------------------------------------------------------
# mc-assistant configuration. Copy to `.env` and edit. All values are optional;
# the defaults connect to a local Java-Edition server on 25565 in offline mode.
# ---------------------------------------------------------------------------

# --- Server connection (Java Edition only; Mineflayer does not do Bedrock) ---
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=Assistant
# offline = cracked/LAN servers; microsoft = premium accounts (needs MS login).
MC_AUTH=offline
# MC_PASSWORD=
# Pin the protocol version only if auto-detection fails, e.g. 1.20.4
# MC_VERSION=

# --- Who it obeys and protects ---
# Your in-game name. If left blank, the first player to talk to it becomes owner.
# MC_OWNER=YourName
# Only the owner can command it (true) or anyone in chat (false).
MC_OWNER_ONLY=true
# Prefix that addresses the bot in public chat (it also answers to its name and whispers).
MC_PREFIX=!

# --- Brain ---
# With a key, plain English is understood via Claude. Without one, a built-in
# keyword parser handles common commands (come, follow, gather, hunt, guard, ...).
# ANTHROPIC_API_KEY=sk-ant-...
# Default is Claude Opus 4.8; set claude-haiku-4-5 for faster/cheaper replies.
MC_MODEL=claude-opus-4-8

# --- Survival tuning ---
MC_EAT_THRESHOLD=16     # hunger (0-20) at/below which it eats
MC_FLEE_HEALTH=6        # health (0-20) at/below which it retreats
MC_DEFEND_RADIUS=8      # blocks: hostiles this close trigger self-defense
MC_GUARD_RADIUS=12      # blocks around you it watches while guarding
MC_FOLLOW_RANGE=3       # how closely it trails you
MC_GATHER_RADIUS=20     # blocks: how far it searches when collecting materials

# --- Task menu ---
# Clickable in-game menu via /tellraw — needs the bot op'd (/op Assistant).
# Without op, the numbered menu ("m 1", "m 2", ...) still works for everyone.
MC_MENU_CLICKABLE=true
# run = clicking fires the task immediately; suggest = pre-fills your chat box.
MC_MENU_CLICK=run

# --- Proactivity & memory ---
# With no orders it finds useful work: sleep at night, cook raw meat, stash
# overflow, harvest crops, replant saplings, torch dark spots, fish when low
# on food. Your commands always take priority (they queue as jobs).
MC_PROACTIVE=true
# Run back for its dropped items after dying.
MC_RECOVER_ITEMS=true

# --- Web dashboard ---
# Local browser control panel (buttons + live status + chat). localhost only.
# Set MC_WEB_PORT=0 to disable.
MC_WEB_PORT=3210
MC_WEB_HOST=127.0.0.1

# --- Behaviour ---
MC_NARRATE=true         # speak what it's doing/feeling in chat
MC_AUTO_RECONNECT=true
MC_RECONNECT_DELAY_MS=5000
MC_LOG_LEVEL=info       # debug | info | warn | error
