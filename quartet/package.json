{
  "name": "quartet",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Quartet — four AI minds dropped into one real-world situation",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build && node scripts/build-single.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test test/*.test.ts",
    "proxy": "node scripts/proxy.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@types/three": "^0.170.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.6"
  }
}
